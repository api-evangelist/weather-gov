                "name": "zoneId",
                "value": "",
                "type": "path",
                "description": "NWS public zone/county identifier"
              },
              {
                "name": "start",
                "value": "2026-05-03T14:30:00Z",
                "type": "query",
                "description": "Start date/time"
              },
              {
                "name": "end",
                "value": "2026-05-03T14:30:00Z",
                "type": "query",
                "description": "End date/time"
              },
              {
                "name": "limit",
                "value": "1",
                "type": "query",
                "description": "Limit"
              }
            ]
          },
          "docs": "Returns a list of observations for a given zone"
        },
        {
          "info": {
            "name": "Weather.gov Returns a List of Observation Stations for a Given Zone",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.weather.gov/zones/forecast/:zoneId/stations",
            "params": [
              {
                "name": "zoneId",
                "value": "",
                "type": "path",
                "description": "NWS public zone/county identifier"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Pagination cursor"
              }
            ]
          },
          "docs": "Returns a list of observation stations for a given zone"
